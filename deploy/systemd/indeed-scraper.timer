[Unit]
Description=advanced-scraper: Indeed-Scraper wöchentlich

[Timer]
# Montags 05:30 Uhr deutscher Zeit, mit bis zu 15 Minuten Streuung.
# Wird vom Installationsskript NICHT aktiviert, erst nach erfolgreichem Testlauf.
OnCalendar=Mon *-*-* 05:30:00 Europe/Berlin
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
